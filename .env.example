# Copy this file to `.env` and fill in the real values. `.env` is gitignored;
# this template is committed so the required names are documented.

# memory | github
# `memory` keeps the whole version chain in process and needs no network — this is
# what the test suite runs against, and the fallback if the venue wifi misbehaves.
APPLYMERGE_BACKEND=memory

# The public repo holding state.json, as owner/name.
APPLYMERGE_REPO=

# From the OAuth App: Settings > Developer settings > OAuth Apps > ApplyMerge.
# The client ID is public. The secret is not — it belongs only in .env.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# A token with read access to the state repo. Optional but wanted: unauthenticated
# reads are capped at 60 an hour per IP, which one demo will exhaust.
APPLYMERGE_TOKEN=
